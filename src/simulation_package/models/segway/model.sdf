<?xml version="1.0" ?>
<sdf version="1.9">    
    <model name='segway' canonical_link='chassis'>

        <link name='chassis'>
            <sensor name="imu_sensor" type="imu">
                <pose>0 0 0 0 0 0</pose>
                <topic>imu</topic>
                <update_rate>100</update_rate>
                <always_on>true</always_on>
            </sensor>
            <pose relative_to='__model__'>0 0 0.25 0 0 0</pose>
            
        
            <inertial auto="true"> <!--inertial properties of the link mass, inertia matix-->
                <mass>1.14395</mass>
            </inertial>

            <visual name='visual'>
                <pose>0 0 0.75 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.2 0.5 2.0</size>
                    </box>
                </geometry>
                <!--let's add color to our link-->
                <material>
                    <ambient>0.0 0.0 1.0 1</ambient>
                    <diffuse>0.0 0.0 1.0 1</diffuse>
                    <specular>0.0 0.0 1.0 1</specular>
                </material>
            </visual>
            <collision name='collision'>
            <pose>0 0 0.75 0 0 0</pose>
                <geometry>
                    <box>
                        <size>0.2 0.5 2.0</size>
                    </box>
                </geometry>
            </collision>
        </link>
        
        <link name='left_wheel'>
            <pose relative_to="chassis">0.0 0.35 0.0 -1.5707 0 0</pose>
            <inertial auto="true">
                <mass>1.0</mass>
            </inertial>
            <visual name='visual'>
                <geometry>
                    <cylinder>
                        <radius>0.4</radius>
                        <length>0.2</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>1.0 0.0 0.0 1</ambient>
                    <diffuse>1.0 0.0 0.0 1</diffuse>
                    <specular>1.0 0.0 0.0 1</specular>
                </material>
            </visual>
            <visual name="rotation_marker">
                <!-- Marker etwas außerhalb der Radflaeche -->
                <pose>0 0 -0.01 0 0 0</pose>

                <geometry>
                    <box>
                        <size>0.05 0.30 0.22</size>
                    </box>
                </geometry>

                <material>
                    <ambient>1 1 0 1</ambient>
                    <diffuse>1 1 0 1</diffuse>
                </material>
            </visual>
            <collision name='collision'>
                <geometry>
                    <cylinder>
                        <radius>0.4</radius>
                        <length>0.2</length>
                    </cylinder>
                </geometry>
            </collision>
        </link>

        <!--The same as left wheel but with different position-->
        <link name='right_wheel'>
            <pose relative_to="chassis">0.0 -0.35 0.0 -1.5707 0 0</pose> <!--angles are in radian-->
            <inertial auto="true">
                <mass>1.0</mass>
            </inertial>
            <visual name='visual'>
                <geometry>
                    <cylinder>
                        <radius>0.4</radius>
                        <length>0.2</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>1.0 0.0 0.0 1</ambient>
                    <diffuse>1.0 0.0 0.0 1</diffuse>
                    <specular>1.0 0.0 0.0 1</specular>
                </material>
            </visual>
            <visual name="rotation_marker">
                <!-- Marker etwas außerhalb der Radfläche -->
                <pose>0 0 -0.01 0 0 0</pose>

                <geometry>
                    <box>
                        <size>0.05 0.30 0.22</size>
                    </box>
                </geometry>

                <material>
                    <ambient>1 1 0 1</ambient>
                    <diffuse>1 1 0 1</diffuse>
                </material>
            </visual>
            <collision name='collision'>
                <geometry>
                    <cylinder>
                        <radius>0.4</radius>
                        <length>0.2</length>
                    </cylinder>
                </geometry>
            </collision>
        </link>

        <frame name="caster_frame" attached_to='chassis'>
            <pose>0.8 0 -0.2 0 0 0</pose>
        </frame>

        

        <joint name='left_wheel_joint' type='revolute'>
            <pose relative_to='left_wheel'/>
            <parent>chassis</parent>
            <child>left_wheel</child>
            <axis>
                <xyz expressed_in='__model__'>0 1 0</xyz> <!--can be defined as any frame or even arbitrary frames-->
                <limit>
                    <lower>-1.79769e+308</lower>    <!--negative infinity-->
                    <upper>1.79769e+308</upper>     <!--positive infinity-->
                </limit>
            </axis>
        </joint>

        <joint name='right_wheel_joint' type='revolute'>
            <pose relative_to='right_wheel'/>
            <parent>chassis</parent>
            <child>right_wheel</child>
            <axis>
                <xyz expressed_in='__model__'>0 1 0</xyz>
                <limit>
                    <lower>-1.79769e+308</lower>    <!--negative infinity-->
                    <upper>1.79769e+308</upper>     <!--positive infinity-->
                </limit>
            </axis>
        </joint>


        <plugin
            filename="gz-sim-diff-drive-system"
            name="gz::sim::systems::DiffDrive">
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>
            <wheel_separation>0.7</wheel_separation>
            <wheel_radius>0.4</wheel_radius>
            <odom_publish_frequency>50</odom_publish_frequency>
            <topic>cmd_vel</topic>
        </plugin>
    </model>

</sdf>